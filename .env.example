# ─────────────────────────────────────────────────────────────────────────────
# QuadriGest — Variáveis de ambiente
# Copie este arquivo para .env e preencha com suas credenciais
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL — Neon.tech (gratuito)
# Obtenha em: https://neon.tech → New Project → Connection string
#
# O Neon fornece duas URLs:
#   DATABASE_URL  → pooled connection (para Prisma em produção/serverless)
#   DIRECT_URL    → direct connection (para migrations e prisma db push)

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
