// prisma/schema.prisma
// Banco: PostgreSQL (Neon.tech gratuito)
// Para usar: defina DATABASE_URL no .env ou nas env vars do Vercel

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon.tech requer connection pooling em produção:
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────
// VEÍCULO
// ──────────────────────────────────────────
model Veiculo {
  id        String   @id @default(cuid())
  placa     String   @unique
  modelo    String
  ano       Int?
  cor       String?
  custo     Float    @default(0)
  chassi    String?
  status    StatusVeiculo @default(DISPONIVEL)
  obs       String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  alugueis     Aluguel[]
  manutencoes  Manutencao[]
  lancamentos  Lancamento[]
}

enum StatusVeiculo {
  DISPONIVEL
  ALUGADO
  MANUTENCAO
  INATIVO
}

// ──────────────────────────────────────────
// ALUGUEL (Viagem/Locação)
// ──────────────────────────────────────────
model Aluguel {
  id          String   @id @default(cuid())
  data        DateTime
  cliente     String
  contato     String?
  duracao     Float?   // horas
  valor       Float
  pagamento   FormaPagamento @default(PIX)
  status      StatusAluguel  @default(CONCLUIDO)
  rota        String?
  obs         String?
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  veiculoId   String
  veiculo     Veiculo  @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  lancamento  Lancamento?
}

enum StatusAluguel {
  CONCLUIDO
  ANDAMENTO
  CANCELADO
}

enum FormaPagamento {
  PIX
  DINHEIRO
  CARTAO_DEBITO
  CARTAO_CREDITO
}

// ──────────────────────────────────────────
// MANUTENÇÃO
// ──────────────────────────────────────────
model Manutencao {
  id          String   @id @default(cuid())
  data        DateTime
  tipo        TipoManutencao
  descricao   String
  custo       Float    @default(0)
  oficina     String?
  proxima     String?  // próxima revisão (texto livre: km ou data)
  status      StatusManutencao @default(CONCLUIDA)
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  veiculoId   String
  veiculo     Veiculo  @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  lancamento  Lancamento?
}

enum TipoManutencao {
  PREVENTIVA
  CORRETIVA
}

enum StatusManutencao {
  CONCLUIDA
  AGENDADA
  ANDAMENTO
}

// ──────────────────────────────────────────
// LANÇAMENTO FINANCEIRO
// ──────────────────────────────────────────
model Lancamento {
  id          String   @id @default(cuid())
  data        DateTime
  descricao   String
  categoria   CategoriaLancamento
  tipo        TipoLancamento
  valor       Float
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Vínculos opcionais (receitas automáticas de aluguéis / custos de manutenção)
  aluguelId     String?   @unique
  aluguel       Aluguel?  @relation(fields: [aluguelId], references: [id], onDelete: SetNull)

  manutencaoId  String?   @unique
  manutencao    Manutencao? @relation(fields: [manutencaoId], references: [id], onDelete: SetNull)

  veiculoId     String?
  veiculo       Veiculo?  @relation(fields: [veiculoId], references: [id], onDelete: SetNull)
}

enum TipoLancamento {
  RECEITA
  DESPESA
}

enum CategoriaLancamento {
  ALUGUEL
  MANUTENCAO
  COMBUSTIVEL
  SEGURO
  LICENCIAMENTO
  PONTO
  MARKETING
  PESSOAL
  EQUIPAMENTO
  OUTROS
}
