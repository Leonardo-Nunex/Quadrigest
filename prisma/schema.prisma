generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Veiculo {
  id           String        @id @default(cuid())
  placa        String        @unique
  modelo       String
  ano          Int?
  cor          String?
  custo        Float         @default(0)
  valorAluguel Float         @default(0)
  chassi       String?
  status       StatusVeiculo @default(DISPONIVEL)
  obs          String?
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt

  alugueis    Aluguel[]
  manutencoes Manutencao[]
  lancamentos Lancamento[]
}

enum StatusVeiculo {
  DISPONIVEL
  ALUGADO
  MANUTENCAO
  INATIVO
}

model Cliente {
  id           String   @id @default(cuid())
  nome         String
  telefone     String
  obs          String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Aluguel {
  id             String         @id @default(cuid())
  data           DateTime
  cliente        String
  contato        String?
  duracao        Float?
  valor          Float
  valorPago      Float          @default(0)
  pagamento      FormaPagamento @default(PIX)
  statusPagamento StatusPagamento @default(PENDENTE)
  dataPagamento  DateTime?
  status         StatusAluguel  @default(CONCLUIDO)
  rota           String?
  obs            String?
  criadoEm      DateTime       @default(now())
  atualizadoEm  DateTime       @updatedAt

  veiculoId  String
  veiculo    Veiculo    @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  lancamento Lancamento?
}

enum StatusAluguel {
  CONCLUIDO
  ANDAMENTO
  CANCELADO
}

enum StatusPagamento {
  PAGO
  PENDENTE
  PARCIAL
}

enum FormaPagamento {
  PIX
  DINHEIRO
  CARTAO_DEBITO
  CARTAO_CREDITO
}

model Manutencao {
  id           String           @id @default(cuid())
  data         DateTime
  tipo         TipoManutencao
  descricao    String
  custo        Float            @default(0)
  oficina      String?
  proxima      String?
  status       StatusManutencao @default(CONCLUIDA)
  criadoEm    DateTime         @default(now())
  atualizadoEm DateTime        @updatedAt

  veiculoId  String
  veiculo    Veiculo    @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  lancamento Lancamento?
}

enum TipoManutencao {
  PREVENTIVA
  CORRETIVA
}

enum StatusManutencao {
  CONCLUIDA
  AGENDADA
  ANDAMENTO
}

model Lancamento {
  id           String              @id @default(cuid())
  data         DateTime
  descricao    String
  categoria    CategoriaLancamento
  tipo         TipoLancamento
  valor        Float
  criadoEm    DateTime            @default(now())
  atualizadoEm DateTime           @updatedAt

  aluguelId    String?    @unique
  aluguel      Aluguel?   @relation(fields: [aluguelId], references: [id], onDelete: SetNull)

  manutencaoId String?    @unique
  manutencao   Manutencao? @relation(fields: [manutencaoId], references: [id], onDelete: SetNull)

  veiculoId    String?
  veiculo      Veiculo?   @relation(fields: [veiculoId], references: [id], onDelete: SetNull)
}

enum TipoLancamento {
  RECEITA
  DESPESA
}

enum CategoriaLancamento {
  ALUGUEL
  MANUTENCAO
  COMBUSTIVEL
  SEGURO
  LICENCIAMENTO
  PONTO
  MARKETING
  PESSOAL
  EQUIPAMENTO
  OUTROS
}
